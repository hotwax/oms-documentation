# GitHub configuration
GITHUB_TOKEN=your_github_personal_access_token_here

# Google Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Script configuration
# Comma-separated list of repositories to fetch releases from
SOURCE_REPOS=hotwax/receiving,hotwax/bopis,hotwax/fulfillment,hotwax/inventory-count,hotwax/transfers,hotwax/facilities,hotwax/preorder,hotwax/oms

# Target month for release notes (Format: YYYY-MM, e.g., 2026-01)
# If left blank, the script defaults to the previous month.
MONTH=

# Set to 'true' to enable Gemini API calls. Defaults to dry-run mode (false).
PRODUCTION=false
